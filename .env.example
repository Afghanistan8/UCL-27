# -------- Deploy + cron (server-side only — never commit .env) --------

# The wallet paying gas for contract deploys, resolve() and predict() calls.
# Must hold Bradbury test GEN. For AI predictor operations, this MUST be the
# same wallet that deployed AIPredictor (predict() is admin-only).
PRIVATE_KEY=

# The AIPredictor contract address (populated by deploy-ai.js, then copied here).
AI_PREDICTOR_ADDRESS=

# Supabase (dedicated UCL '27 project — do NOT reuse the La Liga project).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# football-data.org token, free tier is fine.
FOOTBALL_DATA_API_KEY=

# Optional: Ably for real-time live-score fan-out. Leave blank to disable.
ABLY_API_KEY=

# Shared secret for cron endpoints. Vercel Cron sends
# `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=
